# Echora Environment Configuration
# Copy this file to .env and fill in your values
# NEVER commit .env to version control

# ── Application ─────────────────────────────────────────────────────
APP_ENV=development
LOG_LEVEL=info

# ── Database (PostgreSQL + pgvector) ────────────────────────────────
DATABASE_URL=postgresql+psycopg://postgres:<password>@127.0.0.1:5432/echora

# ── LLM Provider ─────────────────────────────────────────────────────
OPENAI_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1
OPENAI_MODEL=qwen3.6-plus-2026-04-02
OPENAI_MODEL_FALLBACKS=qwen3.6-plus,glm-5.1,qwen3.6-flash-2026-04-16,qwen3.6-35b-a3b,qwen3.6-flash
OPENAI_API_KEY=sk-xxx

# ── Embedding ────────────────────────────────────────────────────────
EMBEDDING_BASE_URL=
EMBEDDING_PROVIDER=volcengine_ark
# Optional native DashScope base URL (auto-derived from EMBEDDING_BASE_URL when empty)
DASHSCOPE_EMBEDDING_BASE_URL=
ARK_API_KEY=sk-xxx
ARK_BASE_URL=https://ark.cn-beijing.volces.com/api/v3
EMBEDDING_MODEL=doubao-embedding-vision-251215
EMBEDDING_MODEL_FALLBACKS=
EMBEDDING_API_KEY=
EMBEDDING_DIMENSIONS=1024
EMBEDDING_TIMEOUT_SECONDS=60
EMBEDDING_MAX_RETRIES=1

# ── Companion experience defaults ───────────────────────────────────
ALLOW_MEMORY_CANDIDATES=true
MEMORY_AUTO_COMMIT_ENABLED=false
PRESENCE_ENABLED=true
TRACE_ENABLED=true
ALLOW_GROWTH_CANDIDATES=true

# ── Server ───────────────────────────────────────────────────────────
BACKEND_HOST=127.0.0.1
BACKEND_PORT=8010
FRONTEND_PORT=3000

# ── CORS ─────────────────────────────────────────────────────────────
CORS_ORIGINS=http://localhost:3000

# ── Paths (relative to project root) ─────────────────────────────────
UV_CACHE_DIR=.cache/uv
NPM_CONFIG_CACHE=.cache/npm
PYTHONPYCACHEPREFIX=.cache/pycache
LOG_DIR=.logs
DATA_DIR=.data
SANDBOX_DIR=.sandbox


# -----------------------------------------------------------------------------
# Discord runtime mode
# -----------------------------------------------------------------------------
DISCORD_USE_GATEWAY=true
DISCORD_REQUIRE_MENTION=true
DISCORD_ENABLE_MESSAGE_CONTENT_INTENT=true
DISCORD_INTERACTIONS_ENDPOINT_URL=

# -----------------------------------------------------------------------------
# Discord multi-bot registry
# -----------------------------------------------------------------------------
DISCORD_BOT_REGISTRY_PATH=.secrets/discord-bots.local.json

# -----------------------------------------------------------------------------
# Shared default guild / channels
# -----------------------------------------------------------------------------
DISCORD_DEFAULT_GUILD_ID=
DISCORD_DEFAULT_TEST_CHANNEL_ID=
DISCORD_DEFAULT_MEMORY_REVIEW_CHANNEL_ID=
DISCORD_DEFAULT_AUDIT_LOG_CHANNEL_ID=

# -----------------------------------------------------------------------------
# Secret values resolved by token_secret_ref
# -----------------------------------------------------------------------------
DISCORD_SECRET_ECHORA_A_TOKEN=
DISCORD_SECRET_ECHORA_B_TOKEN=
# Optional: only needed for an OAuth2 authorization-code exchange, not Bot invite or DM Gateway.
DISCORD_SECRET_ECHORA_A_CLIENT_SECRET=
DISCORD_SECRET_ECHORA_B_CLIENT_SECRET=

# -----------------------------------------------------------------------------
# Discord companionship defaults
# -----------------------------------------------------------------------------
DISCORD_DEFAULT_REPLY_ONLY=true
DISCORD_LOW_FREQUENCY_CHECKIN_ENABLED=false
DISCORD_DEFAULT_CHECKIN_FREQUENCY=off
DISCORD_QUIET_HOURS_ENABLED=true
DISCORD_FOCUS_MODE_RESPECTED=true
DISCORD_PRESENCE_BUDGET_ENABLED=true
DISCORD_MEANINGFUL_SILENCE_ENABLED=true

# -----------------------------------------------------------------------------
# Discord memory and safety defaults
# -----------------------------------------------------------------------------
DISCORD_CHANNEL_MEMORY_DEFAULT_EPHEMERAL=true
DISCORD_CHANNEL_MEMORY_REVIEW_GATED=true
DISCORD_STORE_RAW_DISCORD_MESSAGES=false
DISCORD_STORE_RAW_MEDIA=false
DISCORD_ENABLE_CHANNEL_AUDIT_LOG=true
DISCORD_ENABLE_MEMORY_REVIEW_NOTIFICATIONS=true
